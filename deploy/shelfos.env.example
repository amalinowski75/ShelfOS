# ShelfOS settings for a systemd deploy: copy to /etc/shelfos/env, fill in, then
#
#   sudo chown root:shelfos /etc/shelfos/env && sudo chmod 640 /etc/shelfos/env
#
# It holds the signing secret and every shop API key, so it must not be
# world-readable and must never be committed.
#
# PLAIN KEY=value LINES, NO "export": systemd's EnvironmentFile does not
# understand the prefix and would read the key as "export SHELFOS_ENV". The same
# file works with ./shelfos.sh, which parses it the same way, so one file can
# serve both — drop the "export" from an existing one rather than keeping two.
# Do not quote values unless the quotes are part of the value.

# --- Required in production -------------------------------------------------
SHELFOS_ENV=production

# Signs session cookies, API tokens, and the fingerprint that ties both to the
# current password. Anyone who knows it can forge an admin session without a
# password, so generate your own and keep it out of the repo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out, which also makes it the emergency lever.
SHELFOS_SECRET_KEY=replace-me

# --- Where the data lives ---------------------------------------------------
# Absolute, because the unit mounts the filesystem read-only apart from
# /var/lib/shelfos, and both of these otherwise default to a path relative to the
# working directory — i.e. inside the read-only checkout.
DATABASE_URL=sqlite:////var/lib/shelfos/shelfos.db
SHELFOS_ATTACHMENTS_DIR=/var/lib/shelfos/attachments

# --- First run only ---------------------------------------------------------
# These seed the first admin and are read ONLY while the database has no admin
# who can sign in. Afterwards they change nothing: use the app, or
# `python scripts/set_password.py <username>` with the app stopped.
SHELFOS_ADMIN_USERNAME=admin
SHELFOS_ADMIN_PASSWORD=replace-me-too

# --- Optional ---------------------------------------------------------------
# Sign-in throttle: failures allowed per client address, and the window in
# seconds. 0 failures turns it off.
#SHELFOS_LOGIN_MAX_FAILURES=10
#SHELFOS_LOGIN_FAILURE_WINDOW_SECONDS=900

# Shop lookups; each stays off until its key is set. See the README.
#SHELFOS_MOUSER_API_KEY=
#SHELFOS_DIGIKEY_CLIENT_ID=
#SHELFOS_DIGIKEY_CLIENT_SECRET=
#SHELFOS_TME_TOKEN=
#SHELFOS_TME_SECRET=
#SHELFOS_FARNELL_API_KEY=

# Label printer; leave the device empty and the print buttons stay hidden. A
# device path needs the unit's printer block kept for this to be reachable; a
# tcp://host:port printer — one plugged into somebody's desk, reached through a
# bridge there — does not, and works with the block deleted. See README.md.
#SHELFOS_LABEL_DEVICE=/dev/shelfos-label
# 9100 is only a convention (HP JetDirect's raw-printing port); any free port
# works, as long as the bridge and the tunnel on the printer's machine agree.
#SHELFOS_LABEL_DEVICE=tcp://127.0.0.1:9100
#SHELFOS_LABEL_PRINTER_MODEL=QL-800
#SHELFOS_LABEL_TAPE=62
