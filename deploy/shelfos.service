# ShelfOS under systemd, served to a reverse proxy on the same host.
#
#   sudo cp deploy/shelfos.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shelfos
#
# Read deploy/README.md first. This assumes the layout it sets up: the code at
# /opt/shelfos owned by a "shelfos" system user, the data at /var/lib/shelfos,
# and settings in /etc/shelfos/env.

[Unit]
Description=ShelfOS inventory
Documentation=https://github.com/amalinowski75/ShelfOS
After=network-online.target
Wants=network-online.target

# Restart, but give up rather than loop. ShelfOS refuses to start on some
# misconfigurations by design — a default admin password, a missing secret — and
# those do not improve on the next attempt; a restart loop only buries the one
# log line that says what is wrong. These two live in [Unit], not [Service]:
# systemd ignores them here with a warning nobody reads.
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=exec
User=shelfos
Group=shelfos
WorkingDirectory=/opt/shelfos

# Settings and secrets. systemd does NOT parse a leading "export", so the file
# must be plain KEY=value lines — see deploy/shelfos.env.example. The leading `-`
# means a missing file is not itself an error: ShelfOS then fails on its own
# checks and says which setting is wrong, which is the more useful message.
EnvironmentFile=-/etc/shelfos/env

# --host: written by shelfos.sh from --listen, 127.0.0.1 unless told otherwise.
# Loopback because the proxy is the only thing that should reach this; binding
# 0.0.0.0 publishes the app on the port directly, in plain HTTP, past every
# certificate and header the proxy adds. Worth it on a private bridge or a test
# box, where the alternative is a port forward to reach it at all.
#
# No --reload: it watches the source tree and restarts on writes, which a server
# has no use for.
#
# One worker, deliberately. The sign-in throttle counts failures in one process's
# memory, so a second worker would silently double the allowance, and the label
# printer's job lock is per process too. Put both in shared state before scaling
# this number.
#
# --forwarded-allow-ips: uvicorn believes X-Forwarded-For only from an address it
# trusts. Without it every visitor arrives as the proxy and they all share one
# sign-in allowance. Change it if the proxy runs on another host.
ExecStart=/opt/shelfos/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 9000 \
    --workers 1 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

# Paired with StartLimit* in [Unit] above.
Restart=on-failure
RestartSec=5

# --- Sandboxing -------------------------------------------------------------
# ProtectSystem=strict makes the whole filesystem read-only, /opt/shelfos
# included, so ShelfOS must be pointed at /var/lib/shelfos for both the things it
# writes. DATABASE_URL and SHELFOS_ATTACHMENTS_DIR default to paths *relative to
# the working directory*, which would land in the read-only checkout: set both to
# absolute paths in the environment file, as the example does.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/shelfos

# --- Label printer ----------------------------------------------------------
# Delete this whole block when no Brother QL is attached; PrivateDevices=yes
# above then stands and /dev/usb stays hidden. With a printer, that hiding is
# what has to be undone, and the device let back in.
#
# By device class, not by path. `usblp` hands out the next free index, so the
# printer that is /dev/usb/lp0 today comes back as lp4 after a few replugs —
# which is the whole reason the udev rule in the main README makes a
# /dev/shelfos-label symlink to point SHELFOS_LABEL_DEVICE at. Naming a numbered
# node here would put that instability back in the one place the symlink cannot
# help: DeviceAllow switches the cgroup to deny-by-default, so the renumbered
# node is refused and every print fails with EPERM while the path in the
# configuration still resolves perfectly. `char-usb` is major 180 (see
# /proc/devices), which is every /dev/usb/lp*, whatever number this one got. A
# symlink would not do either — systemd resolves the path once at start, so a
# printer plugged in later would never be allowed.
#
# It is broader than the one printer: major 180 also carries hiddev nodes. That
# costs nothing here, because the cgroup device policy only ever *subtracts* —
# it cannot grant access the file's own permissions refuse, and those nodes are
# root-owned 0600 while this service runs as shelfos.
PrivateDevices=no
DeviceAllow=char-usb rw

# Must name the group the udev rule grants, which in the README's rule is
# plugdev. Left at the kernel default of lp instead if you have no rule and put
# the service user in that group by hand — but then the device number is
# unstable again. These two have to agree: get it wrong and opening the printer
# fails with EACCES, which reads exactly like the printer being absent.
SupplementaryGroups=plugdev

[Install]
WantedBy=multi-user.target
